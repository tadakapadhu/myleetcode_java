class Solution {
    public int minimumCost(int[] cost) {
        int n=cost.length;
        int count=0;
        int total=0;
        Arrays.sort(cost);
        for(int i=n-1;i>=0;i--){
            if(count%3!=2){
                total+=cost[i];
            }
            count++;
        }
        return total;
    }
}
