//389. Find the Difference
class Solution {
    public char findTheDifference(String s, String t) {
        int n=s.length();
        int m=t.length();
        char[] a = s.toCharArray();
        char[] b = t.toCharArray();
        Arrays.sort(a);
        Arrays.sort(b);

        for(int i=0;i<n;i++){
                if(a[i]!=b[i]){
                    return b[i];
                }
            }
                    return b[m-1];
        
    }
}
