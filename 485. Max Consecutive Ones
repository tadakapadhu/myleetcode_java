class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int n=nums.length;
        int c=0;int mx=0;
        for(int i=0;i<n;i++){
            if(nums[i]==1){
                c++;
            }else{
                mx=Math.max(mx,c);
                c=0;
            }
        }
        mx=Math.max(mx,c);
        return mx;
        
    }
}
