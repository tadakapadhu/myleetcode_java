class Solution {
    public int maxVowels(String s, int k) {
        Set<Character> vowels = Set.of('a','e','i','o','u');
        int l=0;
        int c=0;
        int m=0;
        for(int i=0;i<k;i++){
            if(vowels.contains(s.charAt(i))){
                c++;
                
            }
            m=Math.max(m,c);
        }

        for(int r=k;r<s.length();r++){
            if(vowels.contains(s.charAt(l))){
                c--;

            }
            l++;
            if(vowels.contains(s.charAt(r))){
                c++;
            }
            m=Math.max(m,c);
        }

        return m;

        
    }
}
