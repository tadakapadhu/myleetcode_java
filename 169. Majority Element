//169.Majority Element
class Solution {
    public int majorityElement(int[] nums) {
        int n=nums.length;
        int s=0;
        int e=0;
        for(int i=0;i<n;i++){
            if(s==0){
                e=nums[i];
            }
            if(nums[i]==e){
                s++;

            }else{
                s--;
            }
            
        
        }
        return e;
        
    }
}
