class Solution {
    public int differenceOfSum(int[] nums) {
        int n=nums.length;
        int sum=0;
        int ds=0;
        for(int i=0;i<n;i++){
            sum=sum+nums[i];
            int temp=nums[i];
            while(temp>0){
                ds=ds+(temp%10);
                temp=temp/10;
            }
        }
        int ans= Math.abs(sum-ds);
        return ans;
        
    }
}
