//53. Maximum Subarray
class Solution {
    public int maxSubArray(int[] nums) {
        int n=nums.length;
        int mx=nums[0];
        int cmax=nums[0];
        for(int i=1;i<n;i++){
            cmax=Math.max(nums[i],cmax+nums[i]);
            mx=Math.max(mx,cmax);

        }
    
    return mx;
}
}
