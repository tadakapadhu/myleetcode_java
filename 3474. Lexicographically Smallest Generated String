//3474. Lexicographically Smallest Generated String
class Solution(object):
    def generateString(self, str1, str2):
        n = len(str1)
        m = len(str2)

        res = ['?'] * (n + m - 1)
        fixed = [False] * (n + m - 1)

        # Step 1: Apply 'T'
        for i in range(n):
            if str1[i] == 'T':
                for j in range(m):
                    if res[i + j] == '?' or res[i + j] == str2[j]:
                        res[i + j] = str2[j]
                        fixed[i + j] = True
                    else:
                        return ""

        # Step 2: Fill remaining with 'a'
        for i in range(len(res)):
            if res[i] == '?':
                res[i] = 'a'

        # helper: match check
        def match(i):
            for j in range(m):
                if res[i + j] != str2[j]:
                    return False
            return True

        # Step 3: Fix 'F'
        for i in range(n):
            if str1[i] == 'F' and match(i):

                changed = False

                # only change non-fixed positions
                for j in range(m - 1, -1, -1):
                    idx = i + j

                    if not fixed[idx]:   # 🔥 IMPORTANT FIX
                        original = res[idx]

                        for c in 'abcdefghijklmnopqrstuvwxyz':
                            if c == original:
                                continue

                            res[idx] = c

                            if not match(i):
                                changed = True
                                break

                        if changed:
                            break
                        else:
                            res[idx] = original

                if not changed:
                    return ""

        return "".join(res)
