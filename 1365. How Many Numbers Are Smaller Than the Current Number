//1365. How Many Numbers Are Smaller Than the Current Number
class Solution {
    public int[] smallerNumbersThanCurrent(int[] nums) {
        int n=nums.length;
        int[] arr=new int[101];
        for(int i=0;i<n;i++){
            arr[nums[i]]+=1;

        }
        for(int i=1;i<arr.length;i++){
            arr[i]=arr[i-1]+arr[i];
        }

      int[] ans=new int[n];
      for(int i=0;i<n;i++){
        if(nums[i]>0){
        ans[i]=arr[nums[i]-1];
      }
      }
      return ans;
    }
}
